# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GoHighLevel Configuration
#
# Portal -> GHL tagging. Both are required; neither works alone.
# GHL_API_KEY is a Private Integration token (Settings -> Private
# Integrations) with the contacts.readonly and contacts.write scopes. The old
# v1 Location API key no longer exists on current sub-accounts.
# GHL_LOCATION_ID is the Location ID shown on Settings -> Business Profile.
GHL_API_KEY=your-ghl-private-integration-token
GHL_LOCATION_ID=your-ghl-location-id

# GHL -> portal. Shared secret sent as the x-portal-secret header by the
# workflow webhooks. Independent of the two above.
GHL_WEBHOOK_SECRET=your-webhook-secret

# Google Drive Configuration
#
# One service account, three separate folder roots. All four are required —
# each folder id backs a different page, and a missing one takes only that
# page down, which is easy to miss in testing:
#   GOOGLE_DRIVE_FOLDER_ID  -> Handouts   (/resources)
#   GOOGLE_BOOKS_FOLDER_ID  -> Will's Books (/books)
#   GOOGLE_DFG_FOLDER_ID    -> Facilitator's Guide (/guide)
# The service account must be shared into each folder in Drive.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=your-handouts-folder-id
GOOGLE_BOOKS_FOLDER_ID=your-books-folder-id
GOOGLE_DFG_FOLDER_ID=your-guide-folder-id

# App Configuration
# NEXT_PUBLIC_APP_URL is read by nothing at runtime — request origin is used
# instead, so the portal follows whatever domain serves it. Moving to a custom
# domain is a dashboard job, not a code change: see docs/custom-domain.md.
NODE_ENV=development
